{
  "name": "@carnival/dsh-tool-workspace-dependencies",
  "description": "The load_workspace_dependencies tool: absolute paths into a bundled Python, Node.js, and pnpm payload",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-error": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-error": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~"
  }
}
