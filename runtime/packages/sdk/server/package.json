{
  "name": "@carnival/dsh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-attachment": "workspace:*",
    "@carnival/dsh-commands": "workspace:*",
    "@carnival/dsh-goal": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-llm-deepseek-api-key": "workspace:*",
    "@carnival/dsh-permission-presets": "workspace:*",
    "@carnival/dsh-schedule": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-sdk-protocol": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-user-approval": "workspace:*",
    "@carnival/dsh-user-questions": "workspace:*",
    "@carnival/dsh-util-time": "workspace:*",
    "@carnival/dsh-working-directory": "workspace:*",
    "@carnival/dsh-deepseek-auth": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-attachment": "workspace:*",
    "@carnival/dsh-command-compact": "workspace:*",
    "@carnival/dsh-command-goal": "workspace:*",
    "@carnival/dsh-commands": "workspace:*",
    "@carnival/dsh-compaction-basic": "workspace:*",
    "@carnival/dsh-fs": "workspace:*",
    "@carnival/dsh-goal": "workspace:*",
    "@carnival/dsh-goal-round-driver": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-llm-deepseek-api-key": "workspace:*",
    "@carnival/dsh-permission-presets": "workspace:*",
    "@carnival/dsh-plan-mode": "workspace:*",
    "@carnival/dsh-sandbox-policy": "workspace:*",
    "@carnival/dsh-schedule": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-sdk-protocol": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-persistence-jsonl": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-shell": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-token-meter": "workspace:*",
    "@carnival/dsh-tool-goal": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-user-approval": "workspace:*",
    "@carnival/dsh-user-questions": "workspace:*",
    "@carnival/dsh-util-time": "workspace:*",
    "@carnival/dsh-working-directory": "workspace:*",
    "@carnival/dsh-deepseek-auth": "workspace:*"
  }
}
