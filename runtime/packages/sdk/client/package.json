{
  "name": "@carnival/dsh-sdk-client",
  "description": "TypeScript client SDK for driving a DeepSeek Harness runtime subprocess over stdio JSON-RPC: the DeepSeekHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh": "workspace:*"
  },
  "peerDependencies": {
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-sdk-protocol": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-sdk-protocol": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-experimental-translator": "workspace:*"
  }
}
