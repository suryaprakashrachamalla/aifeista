{
  "name": "@carnival/dsh-settings",
  "description": "Abstract user-settings seam (ctx.settings) for the DeepSeek Harness",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "@carnival/cordis-plugin-timer": "workspace:~",
    "@carnival/dsh-app-boot": "workspace:*",
    "@carnival/dsh-hmr": "workspace:*",
    "@carnival/dsh-agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/dsh-config-editor": "workspace:*",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
