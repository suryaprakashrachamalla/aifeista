{
  "name": "@carnival/dsh-plugin-package-inventory-deepseek",
  "description": "Active Loader-backed plugin package inventory for official DeepSeek LLM API requests",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-preset-registry": "workspace:*",
    "@carnival/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@carnival/dsh-session": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@carnival/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carnival/dsh-app-boot": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-preset-registry": "workspace:*",
    "@carnival/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*"
  }
}
