{
  "name": "@carnival/dsh-credentials-local",
  "description": "File-backed credentials provider ($DSH_HOME/.env under the live process environment) for the DeepSeek Harness",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-atomic-write": "workspace:*",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/dsh-launch-environment": "workspace:*",
    "@carnival/dsh-home-paths": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@carnival/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@carnival/dsh-atomic-write": "workspace:*",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/dsh-launch-environment": "workspace:*",
    "@carnival/dsh-home-paths": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
