{
  "name": "@carnival/dsh-credentials",
  "description": "Abstract credential seam (ctx.credentials): settings carry references to secrets, providers own the values",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-launch-environment": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-launch-environment": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*"
  }
}
