{
  "name": "@carnival/dsh-attachment-local",
  "description": "Private content-addressed DSH_HOME attachment storage",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-attachment": "workspace:*",
    "@carnival/dsh-home-paths": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-lazy-require": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@carnival/dsh-attachment": "workspace:*",
    "@carnival/dsh-home-paths": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
