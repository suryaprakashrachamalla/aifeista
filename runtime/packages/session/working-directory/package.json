{
  "name": "@carnival/dsh-working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-fs": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-error": "workspace:*"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-fs": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-fs-local": "workspace:*",
    "@carnival/dsh-error": "workspace:*"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~",
    "zod": "4.6.6"
  }
}
