{
  "name": "@carnival/dsh-tool-session-control",
  "description": "Send model-authored messages to ordinary Web Sessions with acceptance receipts",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-api-session-controller": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-error": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-workspace": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-api-session-controller": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-error": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-workspace": "workspace:*"
  }
}
