{
  "name": "@carnival/dsh-session-telemetry-otel",
  "description": "Feedback-authorized Session logs over byte-bounded OpenTelemetry HTTP requests",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api-logs": "0.222.0",
    "@carnival/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@carnival/dsh-command-feedback": "workspace:*",
    "@carnival/dsh-message-feedback": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-telemetry": "workspace:*",
    "@carnival/dsh-anonymous-user-id": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-otel": "workspace:*"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis-plugin-logger-console": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-app-boot": "workspace:*",
    "@carnival/dsh-bash-local": "workspace:*",
    "@carnival/dsh-command-feedback": "workspace:*",
    "@carnival/dsh-message-feedback": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-loader-smoke": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-checkpoint-policy": "workspace:*",
    "@carnival/dsh-session-persistence-jsonl": "workspace:*",
    "@carnival/dsh-session-telemetry": "workspace:*",
    "@carnival/dsh-subprocess-local": "workspace:*",
    "@carnival/dsh-anonymous-user-id": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-http-proxy": "workspace:*",
    "@carnival/dsh-otel": "workspace:*"
  }
}
