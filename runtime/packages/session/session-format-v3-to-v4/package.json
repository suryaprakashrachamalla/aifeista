{
  "name": "@carnival/dsh-session-format-v3-to-v4",
  "description": "Streaming tool-role migration and delivery validation from Session V3 to V4",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 3,
      "to": 4,
      "export": ".",
      "migration": "sessionFormatV3ToV4",
      "sourceCodec": "releasedV3SessionFormatCodec",
      "targetCodec": "releasedV4SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV4Header",
      "targetRestorer": "restoreReleasedV4Artifact"
    }
  },
  "dependencies": {
    "@carnival/dsh-session-format": "workspace:*",
    "@carnival/dsh-session-format-v2-to-v3": "workspace:*"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
