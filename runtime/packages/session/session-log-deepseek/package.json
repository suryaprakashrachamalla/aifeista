{
  "name": "@carnival/dsh-session-log-deepseek",
  "description": "Incremental lossless session-log request extension for the official DeepSeek LLM API",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@carnival/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-command-feedback": "workspace:*",
    "@carnival/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-llm-deepseek": "workspace:*",
    "@carnival/dsh-llm-deepseek-api-key": "workspace:*",
    "@carnival/dsh-llm-mock-server": "workspace:*",
    "@carnival/dsh-message-feedback": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-persistence-jsonl": "workspace:*",
    "@carnival/dsh-deepseek-auth": "workspace:*"
  }
}
