{
  "name": "@carnival/dsh-session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the DeepSeek Harness",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-persistence": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session-format": "workspace:*",
    "@carnival/dsh-session-format-catalog": "workspace:*",
    "@carnival/dsh-session-format-v3-to-v4": "workspace:*",
    "@carnival/node-addon-system": "workspace:~",
    "@carnival/schemastery": "workspace:~",
    "koffi": "3.1.1",
    "p-limit": "7.3.3"
  },
  "devDependencies": {
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-format-v0-to-v1": "workspace:*",
    "@carnival/dsh-session-persistence": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
