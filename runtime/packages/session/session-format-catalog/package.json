{
  "name": "@carnival/dsh-session-format-catalog",
  "description": "Build-static first-party Session format codec and migration catalog",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./message-projections": {
      "types": "./lib/types/message-projections.d.ts",
      "default": "./lib/types/message-projections.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-session-format": "workspace:*",
    "@carnival/dsh-session-format-v0-to-v1": "workspace:*",
    "@carnival/dsh-session-format-v1-to-v2": "workspace:*",
    "@carnival/dsh-session-format-v2-to-v3": "workspace:*",
    "@carnival/dsh-session-format-v3-to-v4": "workspace:*",
    "@carnival/dsh-compaction-image-offload": "workspace:*"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session": "workspace:*"
  }
}
