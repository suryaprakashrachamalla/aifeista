{
  "name": "@carnival/dsh-tool-lsp",
  "description": "Model-facing lsp tool over the DeepSeek Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-lsp": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-fs-local": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-lsp": "workspace:*",
    "@carnival/dsh-lsp-stdio": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subprocess-local": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/dsh-tool-call-timeout-policy": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-working-directory": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*"
  }
}
