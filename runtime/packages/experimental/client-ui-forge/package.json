{
  "name": "@carnival/dsh-experimental-client-ui-forge",
  "description": "Session panel entries for a Session's change requests, with a worktree option for new Sessions and its Host Remote",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@carnival/dsh-api-remote-access",
        "@carnival/dsh-api-remotes",
        "@carnival/dsh-client-locale",
        "@carnival/dsh-client-ui-conversation",
        "@carnival/dsh-client-ui-layout",
        "@carnival/dsh-client-ui-plugin-manager",
        "@carnival/dsh-client-ui-session-panel",
        "@carnival/dsh-client-ui-settings",
        "@carnival/dsh-client-ui-sidebar-right",
        "@carnival/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-experimental-worktree": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/dsh-experimental-forge": "workspace:*",
    "@carnival/dsh-fs": "workspace:*"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~",
    "@carnival/dsh-util-values": "workspace:*",
    "diff": "^9.0.0",
    "zod": "4.6.6",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-storage-domain": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-api-remote-access": "workspace:*",
    "@carnival/dsh-api-remotes": "workspace:*",
    "@carnival/dsh-api-session-controller": "workspace:*",
    "@carnival/dsh-api-workspace-controller": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-client-locale": "workspace:*",
    "@carnival/dsh-client-store": "workspace:*",
    "@carnival/dsh-client-test-runtime": "workspace:*",
    "@carnival/dsh-client-ui-context-menu": "workspace:*",
    "@carnival/dsh-client-ui-conversation": "workspace:*",
    "@carnival/dsh-client-ui-layout": "workspace:*",
    "@carnival/dsh-client-ui-plugin-manager": "workspace:*",
    "@carnival/dsh-client-ui-primitives": "workspace:*",
    "@carnival/dsh-client-ui-renderer": "workspace:*",
    "@carnival/dsh-client-ui-session": "workspace:*",
    "@carnival/dsh-client-ui-session-panel": "workspace:*",
    "@carnival/dsh-client-ui-settings": "workspace:*",
    "@carnival/dsh-client-ui-sidebar": "workspace:*",
    "@carnival/dsh-client-ui-sidebar-right": "workspace:*",
    "@carnival/dsh-client-ui-slots": "workspace:*",
    "@carnival/dsh-client-ui-workspace": "workspace:*",
    "@carnival/dsh-experimental-forge": "workspace:*",
    "@carnival/dsh-experimental-forge-github": "workspace:*",
    "@carnival/dsh-experimental-forge-session": "workspace:*",
    "@carnival/dsh-experimental-worktree": "workspace:*",
    "@carnival/dsh-fs": "workspace:*",
    "@carnival/dsh-fs-local": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-sandbox": "workspace:*",
    "@carnival/dsh-sandbox-local": "workspace:*",
    "@carnival/dsh-sandbox-policy": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-session-projection-cache": "workspace:*",
    "@carnival/dsh-session-query": "workspace:*",
    "@carnival/dsh-subprocess": "workspace:*",
    "@carnival/dsh-subprocess-local": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/dsh-util-text-search": "workspace:*",
    "@carnival/dsh-util-workspace-path": "workspace:*",
    "@carnival/dsh-working-directory": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/picomatch": "^4.0.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
