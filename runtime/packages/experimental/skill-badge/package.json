{
  "name": "@carnival/dsh-skill-badge",
  "description": "Bundled dsh badge skill provider for DeepSeek Harness",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "assets",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-skill": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-skill": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
