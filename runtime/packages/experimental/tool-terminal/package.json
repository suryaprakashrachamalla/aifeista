{
  "name": "@carnival/dsh-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-terminal": "workspace:*",
    "@carnival/dsh-output-retention": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-jobs": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-terminal": "workspace:*",
    "@carnival/dsh-terminal-bash": "workspace:*",
    "@carnival/dsh-output-retention": "workspace:*",
    "@carnival/dsh-sandbox": "workspace:*",
    "@carnival/dsh-sandbox-policy": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subprocess-local": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-jobs": "workspace:*",
    "@carnival/dsh-jobs-local": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-executor-ptc": "workspace:*",
    "@carnival/dsh-tool-jobs": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-working-directory": "workspace:*"
  }
}
