{
  "name": "@carnival/dsh-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the DeepSeek Harness Auto permission preset",
  "version": "0.2.3-alpha.2",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-instructions": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-permission-presets": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-instructions": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-bash-sandbox": "workspace:*",
    "@carnival/dsh-compaction": "workspace:*",
    "@carnival/dsh-fs-local": "workspace:*",
    "@carnival/dsh-fs-observation-policy": "workspace:*",
    "@carnival/dsh-fs-sandbox": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-llm-deepseek": "workspace:*",
    "@carnival/dsh-llm-deepseek-api-key": "workspace:*",
    "@carnival/dsh-permission-presets": "workspace:*",
    "@carnival/dsh-ptc-runtime-node": "workspace:*",
    "@carnival/dsh-sandbox": "workspace:*",
    "@carnival/dsh-sandbox-policy": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-shell": "workspace:*",
    "@carnival/dsh-shell-env": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-subprocess-local": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tool-bash": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-executor-ptc": "workspace:*",
    "@carnival/dsh-tool-fs": "workspace:*",
    "@carnival/dsh-tool-subagent": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-user-approval": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-working-directory": "workspace:*",
    "@carnival/dsh-deepseek-auth": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
