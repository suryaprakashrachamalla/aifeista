{
  "name": "@carnival/dsh-experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-browser-use": "workspace:*",
    "@carnival/dsh-mcp-client": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-working-directory": "workspace:*",
    "@carnival/dsh-error": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-browser-use": "workspace:*",
    "@carnival/dsh-mcp-client": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-executor-ptc": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-mcp-resources": "workspace:*",
    "@carnival/dsh-ptc-runtime": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/dsh-attachment-local": "workspace:*",
    "@carnival/dsh-session-persistence-jsonl": "workspace:*",
    "@carnival/dsh-working-directory": "workspace:*",
    "@carnival/dsh-fs-local": "workspace:*",
    "@carnival/dsh-error": "workspace:*"
  }
}
