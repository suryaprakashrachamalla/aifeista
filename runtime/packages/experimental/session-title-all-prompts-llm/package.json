{
  "name": "@carnival/dsh-session-title-all-prompts-llm",
  "description": "All-user-messages LLM provider plugin for DeepSeek Harness session titles",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-title": "workspace:*",
    "@carnival/dsh-session-title-llm": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-title": "workspace:*",
    "@carnival/dsh-session-title-llm": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*"
  }
}
