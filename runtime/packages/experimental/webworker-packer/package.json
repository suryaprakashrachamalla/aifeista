{
  "name": "@carnival/dsh-experimental-webworker-packer",
  "description": "Build-time packer for the browser runtime's base VFS image and ordered data-overlay archives",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-pack-vfs-image": "./bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/bin.js",
    "bin.js",
    "lib/repository-*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/dsh-app-boot": "workspace:*",
    "@carnival/dsh-experimental-webworker-runtime": "workspace:*",
    "@carnival/dsh-official-bundles": "workspace:*",
    "@carnival/dsh-session-format": "workspace:*",
    "@carnival/dsh-session-format-catalog": "workspace:*",
    "@carnival/dsh-session-format-v3-to-v4": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@types/picomatch": "^4.0.3"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~"
  }
}
