{
  "name": "@carnival/dsh-webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed DeepSeek Harness Sessions",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-default-model": "workspace:*",
    "@carnival/dsh-agent-preset-registry": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-permission-presets": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-title": "workspace:*",
    "@carnival/dsh-workspace": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-default-model": "workspace:*",
    "@carnival/dsh-agent-preset-registry": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-permission-presets": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-title": "workspace:*",
    "@carnival/dsh-workspace": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-util-values": "workspace:*"
  }
}
