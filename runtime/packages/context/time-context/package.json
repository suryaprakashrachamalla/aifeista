{
  "name": "@carnival/dsh-time-context",
  "description": "Durable per-step context with the current time and elapsed time",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-util-time": "workspace:*"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-app-boot": "workspace:*",
    "@carnival/dsh-bash-local": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-loader-smoke": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-checkpoint-policy": "workspace:*",
    "@carnival/dsh-session-persistence-jsonl": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-subprocess-local": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-util-time": "workspace:*"
  }
}
