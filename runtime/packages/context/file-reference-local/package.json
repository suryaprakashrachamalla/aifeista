{
  "name": "@carnival/dsh-file-reference-local",
  "description": "Local-filesystem ctx.fileReferences provider with bounded fuzzy indexes",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-file-reference": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-file-reference": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-working-directory": "workspace:*",
    "@carnival/dsh-fs-local": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*"
  }
}
