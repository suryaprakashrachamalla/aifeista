{
  "name": "@carnival/dsh-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-jobs": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-workflow": "workspace:*"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-jobs": "workspace:*",
    "@carnival/dsh-jobs-local": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-jobs": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-workflow": "workspace:*",
    "@carnival/dsh-workflow-ptc": "workspace:*"
  }
}
