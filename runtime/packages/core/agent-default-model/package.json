{
  "name": "@carnival/dsh-agent-default-model",
  "description": "Default model selection shared by Agent entry points",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "@carnival/dsh-config-editor": "workspace:*"
  },
  "peerDependencies": {
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-settings": "workspace:*"
  }
}
