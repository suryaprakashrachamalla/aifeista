{
  "name": "@carnival/dsh-system-prompt",
  "description": "System prompt assembly registry for the DeepSeek Harness",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-compaction": "workspace:*"
  }
}
