{
  "name": "@carnival/dsh-tool-executor-native",
  "description": "Native tool execution plugin",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-tools": "workspace:*"
  }
}
