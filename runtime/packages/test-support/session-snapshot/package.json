{
  "name": "@carnival/dsh-session-snapshot",
  "description": "Session-log snapshot core with an ACP protocol adapter, expected-output normalization, and fixture invariants",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/dsh-llm-replay": "workspace:*",
    "@carnival/dsh-loader-smoke": "workspace:*",
    "@carnival/dsh-session-format": "workspace:*",
    "js-yaml": "^4.3.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-http-proxy": "workspace:*"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*",
    "@carnival/dsh-agent-preset-registry": "workspace:*",
    "@carnival/dsh-compaction": "workspace:*",
    "@carnival/dsh-fs": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-persona": "workspace:*",
    "@carnival/dsh-sandbox": "workspace:*",
    "@carnival/dsh-sandbox-policy": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-user-questions": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@carnival/dsh-http-proxy": "workspace:*"
  }
}
