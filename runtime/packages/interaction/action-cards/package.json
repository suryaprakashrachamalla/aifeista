{
  "name": "@carnival/dsh-action-cards",
  "description": "Optional action cards below answers: card state, user actions and status notices",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-api-remote-access": "workspace:*",
    "@carnival/dsh-sandbox-policy": "workspace:*",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/dsh-skill": "workspace:*",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/cosmokit": "workspace:~"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "zod": "4.6.6",
    "@carnival/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
