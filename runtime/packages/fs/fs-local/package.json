{
  "name": "@carnival/dsh-fs-local",
  "description": "Local-filesystem implementation of the DeepSeek Harness filesystem seam (ctx.fs)",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-fs": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "chokidar": "5.0.0",
    "koffi": "3.1.1",
    "@carnival/schemastery": "workspace:~",
    "@carnival/dsh-fs-patch": "workspace:*"
  },
  "devDependencies": {
    "@carnival/dsh-fs": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
