{
  "name": "@carnival/dsh-tencent-meeting",
  "description": "Tencent Meeting plugin: the official tmeet with its skill, and account connection from the Plugins page",
  "version": "0.2.3-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "skills",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "@tencentcloud/tmeet": "1.0.18"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-cli-account": "workspace:*",
    "@carnival/dsh-upstream-skills": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-cli-account": "workspace:*",
    "@carnival/dsh-client-ui-connector-account": "workspace:*",
    "@carnival/dsh-skill": "workspace:*",
    "@carnival/dsh-subprocess": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-upstream-skills": "workspace:*"
  }
}
