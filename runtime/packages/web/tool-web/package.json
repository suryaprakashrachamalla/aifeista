{
  "name": "@carnival/dsh-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-web": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-output-retention": "workspace:*",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-spill-local": "workspace:*",
    "@carnival/dsh-spill-policy": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tool-call-timeout-policy": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-web": "workspace:*",
    "@carnival/dsh-web-deepseek-api": "workspace:*",
    "@carnival/dsh-web-fetch-http": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-token-meter": "workspace:*",
    "@carnival/dsh-launch-environment": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-deepseek-auth": "workspace:*"
  }
}
