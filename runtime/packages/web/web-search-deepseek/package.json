{
  "name": "@carnival/dsh-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/dsh-launch-environment": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-web": "workspace:*",
    "@carnival/dsh-deepseek-auth": "workspace:*"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/dsh-credentials-local": "workspace:*",
    "@carnival/dsh-deepseek-account": "workspace:*",
    "@carnival/dsh-http-proxy": "workspace:*",
    "@carnival/dsh-launch-environment": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-llm-deepseek-account": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-web": "workspace:*",
    "@carnival/dsh-deepseek-auth": "workspace:*"
  }
}
