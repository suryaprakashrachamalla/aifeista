{
  "name": "@carnival/dsh-subagent-spawn-in-process",
  "description": "In-process spawn subagent backend: runs a fresh child agent on ctx.agents",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-bash-local": "workspace:*",
    "@carnival/dsh-subprocess-local": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-llm-deepseek": "workspace:*",
    "@carnival/dsh-llm-deepseek-api-key": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-tool-bash": "workspace:*",
    "@carnival/dsh-tool-subagent": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-session-persistence-jsonl": "workspace:*",
    "@carnival/dsh-deepseek-auth": "workspace:*"
  }
}
