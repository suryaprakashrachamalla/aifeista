{
  "name": "@carnival/dsh-api-job-controller",
  "description": "Job Remote observation stream and the reference-counted client job-output service",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@carnival/dsh-api-gateway/client"
      ],
      "inject": [
        "@carnival/dsh-api-gateway",
        "@carnival/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-api-gateway": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-client-store": "workspace:*",
    "@carnival/dsh-jobs": "workspace:*",
    "@carnival/dsh-jobs-local": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-typert-registry": "workspace:*"
  }
}
