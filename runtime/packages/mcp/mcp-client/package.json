{
  "name": "@carnival/dsh-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-attachment": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-error": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-subprocess": "workspace:*",
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-mcp-resources": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/dsh-authorization": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-output-retention": "workspace:*"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.2.0",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@modelcontextprotocol/core": "2.2.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-attachment": "workspace:*",
    "@carnival/dsh-attachment-local": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-error": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-subprocess": "workspace:*",
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/dsh-tool-executor-native": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@carnival/dsh-mcp-resources": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-authorization": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*",
    "@carnival/dsh-credentials-local": "workspace:*",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-output-retention": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@carnival/dsh-mcp-resources": {
      "optional": true
    },
    "@carnival/dsh-system-prompt": {
      "optional": true
    },
    "@carnival/dsh-authorization": {
      "optional": true
    },
    "@carnival/dsh-host-webserver": {
      "optional": true
    }
  }
}
