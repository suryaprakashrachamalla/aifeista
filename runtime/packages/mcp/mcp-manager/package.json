{
  "name": "@carnival/dsh-mcp-manager",
  "description": "MCP server manager: a settings-driven fleet of mcp-client instances with runtime status, restart, and probe",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-mcp-client": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-credentials": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/dsh-mcp-client": "workspace:*",
    "@carnival/dsh-settings": "workspace:*",
    "@carnival/dsh-system-prompt": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-app-boot": "workspace:*",
    "@carnival/dsh-config-editor": "workspace:*",
    "@carnival/dsh-hmr": "workspace:*",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/cordis-plugin-timer": "workspace:~",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*"
  }
}
