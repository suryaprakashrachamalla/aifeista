{
  "name": "@carnival/dsh-client-remote-connection",
  "description": "QR login, private login links, and owner-approved browser pairing",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@carnival/dsh-api-remotes",
        "@carnival/dsh-client-locale",
        "@carnival/dsh-client-ui-settings-general",
        "@carnival/dsh-api-remote-access",
        "@carnival/dsh-client-resources"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "dependencies": {
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/dsh-error": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*",
    "@carnival/dsh-web-app": "workspace:*",
    "@carnival/dsh-api-remotes": "workspace:*",
    "@carnival/dsh-client-locale": "workspace:*",
    "@carnival/dsh-client-store": "workspace:*",
    "@carnival/dsh-client-ui-primitives": "workspace:*",
    "@carnival/dsh-client-ui-slots": "workspace:*",
    "@carnival/dsh-client-ui-renderer": "workspace:*",
    "@carnival/dsh-client-ui-layout": "workspace:*",
    "@carnival/dsh-client-test-runtime": "workspace:*",
    "@carnival/dsh-remote-mock": "workspace:*",
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "react": "^18.2.0",
    "qrcode.react": "^4.2.0",
    "@carnival/dsh-client-ui-settings": "workspace:*",
    "@carnival/dsh-api-gateway": "workspace:*",
    "@carnival/dsh-typert-registry": "workspace:*",
    "@carnival/dsh-client-ui-settings-general": "workspace:*",
    "@carnival/dsh-host-authentication-token": "workspace:*",
    "@carnival/dsh-host-frontend-static": "workspace:*",
    "@carnival/dsh-api-remote-access": "workspace:*",
    "@carnival/dsh-client-resources": "workspace:*",
    "@carnival/dsh-error": "workspace:*"
  }
}
