{
  "name": "@carnival/dsh-client-modules",
  "description": "Client module system, dual-face: node half composes the __DSH_BOOT__ entry graph (incremental dsh.client scan, bundle route, index tap, webPlugins service); browser half is the lazy-CJS module table the vendored cordis Loader consumes as its internal seam",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-host-webserver": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-package-manifest": "workspace:*",
    "@carnival/dsh-client-store": "workspace:*",
    "@carnival/dsh-client-script-realm": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/dsh-client-config": "workspace:*",
    "@carnival/dsh-typert-protocol": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "peerDependencies": {
    "@carnival/cordis": "workspace:~"
  }
}
