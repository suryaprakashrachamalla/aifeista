    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@carnival/dsh-client-store": "workspace:*",
    "react": "^18.2.0",
    "@carnival/cordis": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "peerDependencies": {
    "@carnival/cordis": "workspace:~"
  }
