{
  "name": "@carnival/dsh-client-product-analytics",
  "description": "Desktop product event collection and authenticated Host reporting",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/events.d.ts"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@carnival/dsh-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-api-gateway": "workspace:*",
    "@carnival/dsh-compaction": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-host-product-telemetry-otel": "workspace:*",
    "@carnival/dsh-deepseek-account": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*",
    "@carnival/dsh-settings": "workspace:*",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-otel": "workspace:*",
    "@carnival/dsh-app-boot": "workspace:*",
    "@carnival/dsh-loader-smoke": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "dependencies": {
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "zod": "4.6.6"
  }
}
