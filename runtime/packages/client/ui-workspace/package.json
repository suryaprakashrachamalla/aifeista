{
  "name": "@carnival/dsh-client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@carnival/dsh-api-remote-access",
        "@carnival/dsh-api-remotes",
        "@carnival/dsh-api-session-controller",
        "@carnival/dsh-api-workspace-controller",
        "@carnival/dsh-client-connection",
        "@carnival/dsh-client-locale",
        "@carnival/dsh-client-shortcuts",
        "@carnival/dsh-client-ui-conversation",
        "@carnival/dsh-client-ui-layout",
        "@carnival/dsh-client-ui-renderer",
        "@carnival/dsh-client-ui-session",
        "@carnival/dsh-client-ui-session-status",
        "@carnival/dsh-client-ui-sidebar",
        "@carnival/dsh-client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-preset-registry": "workspace:*",
    "@carnival/dsh-api-remote-access": "workspace:*",
    "@carnival/dsh-api-remotes": "workspace:*",
    "@carnival/dsh-api-session-controller": "workspace:*",
    "@carnival/dsh-api-workspace-controller": "workspace:*",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-client-config": "workspace:*",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-client-locale": "workspace:*",
    "@carnival/dsh-client-product-analytics": "workspace:*",
    "@carnival/dsh-client-shortcuts": "workspace:*",
    "@carnival/dsh-client-store": "workspace:*",
    "@carnival/dsh-client-test-runtime": "workspace:*",
    "@carnival/dsh-client-ui-context-menu": "workspace:*",
    "@carnival/dsh-client-ui-conversation": "workspace:*",
    "@carnival/dsh-client-ui-layout": "workspace:*",
    "@carnival/dsh-client-ui-primitives": "workspace:*",
    "@carnival/dsh-client-ui-renderer": "workspace:*",
    "@carnival/dsh-client-ui-session": "workspace:*",
    "@carnival/dsh-client-ui-session-status": "workspace:*",
    "@carnival/dsh-client-ui-sidebar": "workspace:*",
    "@carnival/dsh-client-ui-slots": "workspace:*",
    "@carnival/dsh-jobs": "workspace:*",
    "@carnival/dsh-schedule": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-util-text-search": "workspace:*",
    "@carnival/dsh-util-values": "workspace:*",
    "@carnival/dsh-util-workspace-path": "workspace:*",
    "clsx": "^2.0.0",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ]
}
