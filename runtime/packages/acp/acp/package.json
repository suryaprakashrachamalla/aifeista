{
  "name": "@carnival/dsh-acp",
  "description": "Automation-only Agent Client Protocol server for driving DeepSeek Harness agents over JSON-RPC stdio",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-attachment": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-mcp-client": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-persistence": "workspace:*",
    "@carnival/dsh-token-meter": "workspace:*",
    "@carnival/dsh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@carnival/dsh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-attachment": "workspace:*",
    "@carnival/dsh-fs": "workspace:*",
    "@carnival/dsh-fs-local": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-mcp-client": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-persistence": "workspace:*",
    "@carnival/dsh-session-persistence-jsonl": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-subagent": "workspace:*",
    "@carnival/dsh-token-meter": "workspace:*",
    "@carnival/dsh-tool-testkit": "workspace:*",
    "@carnival/dsh-tools": "workspace:*",
    "@carnival/dsh-user-approval": "workspace:*"
  }
}
