{
  "name": "@carnival/dsh-workspace",
  "description": "Workspace entity registry (ctx.workspaceRegistry): durable workspace records with validated session attachment over the domain data form for the DeepSeek Harness",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-persistence": "workspace:*",
    "@carnival/dsh-storage": "workspace:*",
    "@carnival/dsh-storage-domain": "workspace:*",
    "@carnival/dsh-typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-persistence": "workspace:*",
    "@carnival/dsh-storage": "workspace:*",
    "@carnival/dsh-storage-domain": "workspace:*",
    "@carnival/dsh-typert-protocol": "workspace:*"
  }
}
