{
  "name": "@carnival/dsh-spill",
  "description": "Abstract spill storage seam (ctx.spillStore) for the DeepSeek Harness — save oversized tool text and return a retrieval locator",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-llm": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
