{
  "name": "@carnival/dsh-terminal-bash",
  "description": "Persistent shell PTY backend over the DeepSeek Harness subprocess terminal primitive",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-terminal": "workspace:*",
    "@carnival/dsh-sandbox": "workspace:*",
    "@carnival/dsh-sandbox-policy": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-subprocess": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-lazy-require": "workspace:*",
    "@carnival/dsh-pwsh-local": "workspace:*",
    "@carnival/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-terminal": "workspace:*",
    "@carnival/dsh-sandbox": "workspace:*",
    "@carnival/dsh-sandbox-policy": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-session-projection": "workspace:*",
    "@carnival/dsh-subprocess": "workspace:*",
    "@carnival/dsh-subprocess-local": "workspace:*",
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-working-directory": "workspace:*"
  }
}
