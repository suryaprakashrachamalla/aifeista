{
  "name": "@carnival/dsh-host-webserver",
  "description": "Web route-registration plugin: HTTP and upgrade routes, per-Peer index transform taps, and static dist fallback",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~",
    "compression": "^1.8.1",
    "ipaddr.js": "^2.5.0",
    "negotiator": "^1.1.0"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/negotiator": "^0.6.5",
    "selfsigned": "^4.0.1"
  }
}
