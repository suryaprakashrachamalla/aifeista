{
  "name": "@carnival/dsh-host-frontend-static",
  "description": "SPA dist server for the Web shell: owns the webserver fallback seat, serving explicit index entries and static assets with traversal rejection and 404 misses",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-host-webserver": "workspace:*",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/dsh-host-authentication-token": "workspace:*",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-credentials-local": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
