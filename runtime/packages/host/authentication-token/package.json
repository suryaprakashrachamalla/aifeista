{
  "name": "@carnival/dsh-host-authentication-token",
  "description": "Default token authentication provider and HTTP cookie exchange",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/de.json": "./locale/de.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/es.json": "./locale/es.json",
    "./locale/fr.json": "./locale/fr.json",
    "./locale/ja.json": "./locale/ja.json",
    "./locale/pt.json": "./locale/pt.json",
    "./locale/ru.json": "./locale/ru.json",
    "./locale/zh.json": "./locale/zh.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/de.json",
    "locale/en.json",
    "locale/es.json",
    "locale/fr.json",
    "locale/ja.json",
    "locale/pt.json",
    "locale/ru.json",
    "locale/zh.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@carnival/dsh-credentials": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*",
    "@carnival/dsh-credentials-local": "workspace:*",
    "@carnival/dsh-typert-protocol": "workspace:*",
    "@carnival/dsh-host-frontend-static": "workspace:*"
  }
}
