{
  "name": "@carnival/dsh-host-directory-picker-auto",
  "description": "Adaptive chooser of the directory-picker seam: resolves the host situation at boot and mounts the native or browse backend for the DeepSeek Harness web GUI host",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-client-ui-directory-picker-browse": "workspace:*",
    "@carnival/dsh-client-ui-directory-picker-native": "workspace:*",
    "@carnival/dsh-host-directory-picker-browse": "workspace:*",
    "@carnival/dsh-host-directory-picker-native": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-client-connection": "workspace:*",
    "@carnival/dsh-client-ui-directory-picker-browse": "workspace:*",
    "@carnival/dsh-client-ui-directory-picker-native": "workspace:*",
    "@carnival/dsh-host-directory-picker": "workspace:*",
    "@carnival/dsh-host-directory-picker-browse": "workspace:*",
    "@carnival/dsh-host-directory-picker-native": "workspace:*",
    "@carnival/dsh-host-webserver": "workspace:*"
  },
  "dependencies": {
    "@carnival/dsh-launch-environment": "workspace:*"
  }
}
