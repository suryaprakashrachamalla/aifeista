{
  "name": "@carnival/dsh-jobs-local",
  "description": "Process-local implementation of the DeepSeek Harness background job registry seam",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-jobs": "workspace:*",
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/cordis": "workspace:~"
  },
  "dependencies": {
    "@carnival/dsh-brand": "workspace:*",
    "@carnival/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@carnival/cordis-plugin-include": "workspace:~",
    "@carnival/cordis-plugin-loader": "workspace:~",
    "@carnival/dsh-agent": "workspace:*",
    "@carnival/dsh-agent-loop-testkit": "workspace:*",
    "@carnival/dsh-scope": "workspace:*",
    "@carnival/dsh-session": "workspace:*",
    "@carnival/dsh-jobs": "workspace:*",
    "@carnival/dsh-timeout": "workspace:*",
    "@carnival/cordis": "workspace:~"
  }
}
