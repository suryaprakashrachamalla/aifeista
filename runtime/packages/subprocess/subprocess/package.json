{
  "name": "@carnival/dsh-subprocess",
  "description": "Subprocess seam (ctx.subprocess) for the DeepSeek Harness — managed process groups, bounded spill-backed output, and escalated kills behind one abstract service",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./control": {
      "types": "./lib/types/control.d.ts",
      "default": "./lib/control.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/control.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-http-proxy": "workspace:*",
    "@carnival/dsh-error": "workspace:*"
  },
  "devDependencies": {
    "@carnival/cordis": "workspace:~",
    "@carnival/dsh-http-proxy": "workspace:*",
    "@carnival/dsh-launch-environment": "workspace:*",
    "@carnival/dsh-error": "workspace:*"
  }
}
